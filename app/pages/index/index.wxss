/* pages/index/index.wxss */
.page { padding: 0 24rpx 40rpx; }

/* 品牌头 */
.hero { background: linear-gradient(160deg,#12211c,#1d3a30); border-radius: 0 0 40rpx 40rpx; padding: 40rpx 32rpx 36rpx; margin: 0 -24rpx 24rpx; color:#fff; }
.hero-brand { font-size:44rpx; font-weight:700; letter-spacing:1rpx; }
.hero-sub { font-size:24rpx; color:#9fb3aa; margin-top:12rpx; }
.hero-stats { margin-top:28rpx; align-items:center; }
.hs { display:flex; flex-direction:column; }
.hs-num { font-size:38rpx; font-weight:700; color:#e9a13b; }
.hs-lab { font-size:20rpx; color:#8fa39a; margin-top:4rpx; }
.hs-div { width:1rpx; height:50rpx; background:rgba(255,255,255,.15); margin:0 32rpx; }

/* 搜索 */
.search { background:#fff; border-radius:999rpx; padding:24rpx 30rpx; margin-bottom:20rpx; box-shadow:0 4rpx 16rpx rgba(18,33,28,.08); }
.search-ph { font-size:28rpx; color:#9aa8a2; }
.search-arrow { font-size:28rpx; color:#0e7c5a; margin-left:14rpx; }
.ico { font-size:28rpx; margin-right:12rpx; }

/* 试试搜 */
.try { flex-wrap:wrap; margin-bottom:24rpx; }
.try-label { font-size:24rpx; color:#8a9a94; margin-right:8rpx; }
.try-word { font-size:24rpx; color:#0e7c5a; padding:8rpx 20rpx; background:#e6f4ee; border-radius:999rpx; margin:4rpx 10rpx 4rpx 0; }

/* 接上次读 */
.resume { padding:24rpx 26rpx; margin-bottom:24rpx; }
.resume-l { margin-bottom:12rpx; }
.resume-ico { font-size:26rpx; margin-right:10rpx; }
.resume-label { font-size:24rpx; color:#8a9a94; }
.resume-title { font-size:30rpx; font-weight:600; color:#1a1a1a; line-height:1.4; }
.resume-ch { font-size:22rpx; color:#0e7c5a; margin-top:10rpx; }

/* 今日一条 */
.today { padding:28rpx; margin-bottom:24rpx; }
.today-top { margin-bottom:16rpx; }
.today-ico { font-size:28rpx; margin-right:10rpx; }
.today-label { font-size:24rpx; color:#8a9a94; }
.today-change { font-size:24rpx; color:#0e7c5a; padding:6rpx 18rpx; background:#e6f4ee; border-radius:999rpx; }
.today-title { font-size:36rpx; font-weight:700; color:#12211c; line-height:1.4; }
.today-tags { margin:16rpx 0 14rpx; }
.today-tier { font-size:20rpx; padding:4rpx 14rpx; border-radius:999rpx; margin-right:10rpx; }
.today-lv { font-size:20rpx; padding:4rpx 12rpx; border-radius:999rpx; }
.today-plain { font-size:26rpx; color:#55635e; line-height:1.7; max-height:170rpx; overflow:hidden; }
.today-foot { justify-content:space-between; align-items:center; margin-top:20rpx; padding-top:16rpx; border-top:1rpx solid #eef1ef; }
.today-ch { font-size:22rpx; color:#8a9a94; }
.today-go { font-size:24rpx; color:#0e7c5a; font-weight:600; }

/* 模式切换 */
.mode-switch { display:flex; flex-direction:row; background:#e8ebe9; border-radius:999rpx; padding:6rpx; margin-bottom:28rpx; }
.mode-btn { flex:1; text-align:center; font-size:26rpx; color:#6b7a75; padding:14rpx 0; border-radius:999rpx; }
.mode-btn.on { background:#fff; color:#0e7c5a; font-weight:600; box-shadow:0 2rpx 8rpx rgba(0,0,0,.06); }

/* 区块标题 */
.sec-head { justify-content:space-between; align-items:center; margin:0 4rpx 16rpx; }
.sec-title { font-size:32rpx; font-weight:700; color:#12211c; }
.sec-note { font-size:22rpx; color:#8a9a94; }

/* 场景网格 */
.sc-grid { display:flex; flex-direction:row; flex-wrap:wrap; justify-content:space-between; margin-bottom:8rpx; }
.sc-cell { width:48.5%; padding:22rpx 20rpx; margin-bottom:16rpx; }
.sc-head { margin-bottom:12rpx; }
.sc-ico { font-size:36rpx; }
.sc-count { font-size:20rpx; color:#8a9a94; }
.sc-name { font-size:30rpx; font-weight:700; color:#1a1a1a; }
.sc-desc { font-size:22rpx; color:#6b7a75; line-height:1.5; margin-top:8rpx; height:66rpx; overflow:hidden; }

/* 清单 */
.ck-list { padding:6rpx 24rpx; }
.ck-row { display:flex; flex-direction:row; align-items:center; padding:24rpx 0; border-bottom:1rpx solid #eef1ef; }
.ck-row:last-child { border-bottom:none; }
.ck-ico { font-size:40rpx; margin-right:20rpx; }
.ck-name { font-size:28rpx; font-weight:600; color:#1a1a1a; }
.ck-desc { font-size:22rpx; color:#8a9a94; margin-top:6rpx; }
.ck-arrow { font-size:32rpx; color:#c0c8c4; margin-left:12rpx; }

/* 主题网格 */
.cat-grid { display:flex; flex-direction:row; flex-wrap:wrap; justify-content:space-between; margin-bottom:8rpx; }
.cat-cell { width:48.5%; padding:24rpx 22rpx; margin-bottom:16rpx; }
.cat-head { margin-bottom:14rpx; }
.cat-ico { font-size:40rpx; }
.cat-count { font-size:20rpx; color:#5a6862; }
.cat-name { font-size:30rpx; font-weight:700; color:#1a1a1a; }
.cat-desc { font-size:22rpx; color:#55635e; line-height:1.5; margin-top:8rpx; height:66rpx; overflow:hidden; }

/* 性价比排行 */
.top-list { padding:8rpx 24rpx; }
.top-row { display:flex; flex-direction:row; align-items:center; padding:22rpx 0; border-bottom:1rpx solid #eef1ef; }
.top-row:last-child { border-bottom:none; }
.top-ring { width:76rpx; height:76rpx; border-radius:50%; border:5rpx solid #0e7c5a; display:flex; align-items:center; justify-content:center; margin-right:20rpx; flex:none; }
.top-ring-num { font-size:26rpx; font-weight:700; color:#0e7c5a; }
.top-main { min-width:0; }
.top-title { font-size:28rpx; font-weight:600; color:#1a1a1a; line-height:1.4; }
.top-meta { margin-top:8rpx; }
.top-tier { font-size:19rpx; padding:3rpx 12rpx; border-radius:999rpx; margin-right:10rpx; }
.top-lv { font-size:19rpx; padding:3rpx 12rpx; border-radius:999rpx; }

.about { text-align:center; color:#a8b4af; font-size:22rpx; margin-top:28rpx; }
