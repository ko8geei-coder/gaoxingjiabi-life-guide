/* pages/fav/fav.wxss */
.page { padding: 0 24rpx 40rpx; }

/* 标题 */
.head { padding: 28rpx 4rpx 20rpx; }
.eyebrow { font-size:24rpx; color:#0e7c5a; margin-bottom:10rpx; }
.title { font-size:44rpx; font-weight:700; color:#12211c; line-height:1.3; }
.sub { font-size:24rpx; color:#8a9a94; margin-top:12rpx; }

/* 分段切换 */
.seg { display:flex; flex-direction:row; background:#e8ebe9; border-radius:999rpx; padding:6rpx; margin-bottom:28rpx; }
.seg-btn { flex:1; text-align:center; font-size:26rpx; color:#6b7a75; padding:14rpx 0; border-radius:999rpx; }
.seg-btn.on { background:#0e7c5a; color:#fff; font-weight:600; }

.sec-label { font-size:28rpx; font-weight:700; color:#12211c; margin:0 4rpx 16rpx; }

/* 条目 */
.item { display:flex; flex-direction:row; padding:24rpx; margin-bottom:16rpx; }
.score-badge { width:64rpx; height:64rpx; border-radius:16rpx; display:flex; align-items:center; justify-content:center; margin-right:20rpx; flex:none; }
.score-badge-num { font-size:26rpx; font-weight:700; color:#fff; }
.item-main { min-width:0; }
.item-head { align-items:flex-start; }
.item-title { font-size:30rpx; font-weight:600; line-height:1.4; margin-right:12rpx; }
.unfav { font-size:24rpx; color:#c0504d; flex:none; }
.item-meta { margin-top:10rpx; align-items:center; }
.item-lv { font-size:20rpx; padding:4rpx 12rpx; border-radius:8rpx; }
.item-ch { font-size:20rpx; color:#a8b4af; margin-left:12rpx; }

/* 最近阅读（纵向） */
.item.his { display:block; }
.item.his .item-lv { flex:none; }
.item-ch2 { font-size:22rpx; color:#a8b4af; margin-top:8rpx; }
.prog-row { align-items:center; margin-top:18rpx; }
.prog { height:10rpx; background:#e8ebe9; border-radius:999rpx; overflow:hidden; }
.prog-in { height:100%; background:#0e7c5a; border-radius:999rpx; }
.prog-txt { font-size:20rpx; color:#8a9a94; margin-left:16rpx; }
.go-read { margin-top:18rpx; background:#e6f4ee; color:#0e7c5a; font-size:26rpx; font-weight:600; text-align:center; border-radius:999rpx; padding:16rpx 0; }
.go-read.done { background:#f2f4f2; color:#8a9a94; }

/* 空状态 */
.empty { text-align:center; padding: 60rpx 20rpx; }
.empty-ring { width:120rpx; height:120rpx; border-radius:50%; background:#e6f4ee; color:#0e7c5a; font-size:52rpx; display:flex; align-items:center; justify-content:center; margin:0 auto 28rpx; }
.empty-title { font-size:32rpx; font-weight:700; color:#12211c; }
.empty-sub { font-size:24rpx; color:#8a9a94; line-height:1.6; margin-top:14rpx; }
.empty-btn { display:inline-block; margin-top:32rpx; background:#0e7c5a; color:#fff; font-size:28rpx; font-weight:600; border-radius:999rpx; padding:20rpx 56rpx; }

.foot-note { text-align:center; color:#bcc6c2; font-size:22rpx; margin-top:40rpx; }
