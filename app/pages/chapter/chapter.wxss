/* pages/chapter/chapter.wxss */
.page { padding: 0 24rpx 40rpx; }
.head { padding:24rpx 4rpx 20rpx; }
.head-row { justify-content:flex-end; }
.toc-btn { background:#fff; color:#0e7c5a; border:1rpx solid #d8e5df; border-radius:999rpx; font-size:24rpx; font-weight:600; padding:10rpx 28rpx; }
.title { font-size:34rpx; font-weight:700; color:#12211c; line-height:1.4; }
.sub { font-size:24rpx; color:#8a9a94; margin-top:8rpx; }

/* 章内搜索 */
.ch-search { padding:0 0 20rpx; }
.ch-search input { background:#fff; border:1rpx solid #e3e8e5; border-radius:999rpx; padding:16rpx 30rpx; font-size:26rpx; }

/* 目录：全屏扁平化页面 */
.toc-page { position:fixed; top:0; left:0; right:0; bottom:0; z-index:41; background:#f4f7f5; display:flex; flex-direction:column; }
.toc-head { background:linear-gradient(135deg,#12211c,#1d3a30); color:#fff; padding:32rpx; display:flex; align-items:center; }
.toc-head-l { flex:1; }
.toc-head-title { font-size:36rpx; font-weight:800; letter-spacing:1rpx; }
.toc-head-sub { font-size:22rpx; color:#9db8ad; margin-top:4rpx; }
.toc-close { width:60rpx; height:60rpx; border-radius:50%; background:rgba(255,255,255,.14); color:#fff; font-size:28rpx; display:flex; align-items:center; justify-content:center; }
.toc-list { flex:1; height:0; padding:8rpx 28rpx 48rpx; box-sizing:border-box; }
.toc-cat { display:flex; align-items:center; font-size:22rpx; font-weight:800; color:#8a9a94; letter-spacing:2rpx; margin:28rpx 4rpx 16rpx; }
.toc-cat-dot { width:16rpx; height:16rpx; border-radius:50%; margin-right:12rpx; }
.toc-item { display:flex; align-items:center; background:#fff; border-radius:24rpx; padding:20rpx 24rpx; margin-bottom:12rpx; }
.toc-num { width:68rpx; height:68rpx; border-radius:20rpx; color:#fff; font-size:26rpx; font-weight:800; display:flex; align-items:center; justify-content:center; margin-right:24rpx; flex:none; }
.toc-name { flex:1; font-size:27rpx; color:#1c2b26; font-weight:600; line-height:1.35; }
.toc-cnt { font-size:22rpx; color:#9aa8a2; }
.toc-on { background:#e6f4ee; }
.toc-on .toc-name { color:#0e7c5a; }
.toc-on .toc-cnt { color:#0e7c5a; }

/* 分组 */
.group { margin-bottom:16rpx; }
.group-title { font-size:26rpx; font-weight:700; color:#0e7c5a; padding:16rpx 4rpx 12rpx; }

/* 条目 */
.item { display:flex; flex-direction:row; padding:24rpx; margin-bottom:16rpx; }
.score-badge { width:64rpx; height:64rpx; border-radius:16rpx; display:flex; align-items:center; justify-content:center; margin-right:20rpx; flex:none; }
.score-badge-num { font-size:26rpx; font-weight:700; color:#fff; }
.item-main { min-width:0; }
.item-head { align-items:flex-start; }
.item-title { font-size:30rpx; font-weight:600; line-height:1.4; margin-right:12rpx; }
.star { font-size:34rpx; color:#ddd; flex:none; }
.star.on { color:#e9a13b; }
.item-meta { margin:10rpx 0; }
.item-lv { font-size:20rpx; padding:4rpx 12rpx; border-radius:8rpx; }
.item-plain { font-size:26rpx; color:#666; line-height:1.6; }
.empty { text-align:center; color:#bbb; padding:80rpx 0; font-size:26rpx; }
